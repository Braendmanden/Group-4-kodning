pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	tilesize = 8  --size of tiles
	offset_x = 24 --x offset of grid
	offset_y = 20 --y offset of grid
	border_col = 9 --color of the grid
	grid = {}
	for x = 1, 10 do
	grid[x] = {}
	for y = 1, 10 do
	grid[x][y] = 0
	revealed = false --our bool checking if a tile has been revealed, set to false
	end
	end
	poke(0x5f2d, 1)
	cannon_x = 64
	cannon_y = 115
	position=100
	timer=3000
	true_timer=0
	
end

function _update()
	mx = stat(32) --mouse cursor x posttion
	my =	stat(33) --mouse cursor y position
	prev_btn =	stat(34) --button held
	local col = flr(mx-offset_x)/(tilesize)+1
	local row = flr(my-offset_y)/(tilesize)+1
	if (timer>0) then
	timer=timer-1
	true_timer=flr(timer/30)
 local mouse_x = stat(32) 
 cannon_x = mid(10, mouse_x, 117)
	end
end

function _draw()
	cls()
	spr(1,4,64) --l alien guy
	spr(1,4,54) --l one more
	spr(1,4,44) --l one more
	spr(1,4,34) --l one more
	spr(1,116,64) --r one more
	spr(1,116,54) --r one more
	spr(1,116,44) --r one more
	spr(1,116,34) --r one more
	print("timer: "..true_timer,1,1,10)
	print("space spree:",40,10,12) //title card

--cannon body 
	rectfill(cannon_x-8, cannon_y, cannon_x+8, cannon_y+8, 12)

--cannon barrel 
	rectfill(cannon_x-2, cannon_y-6, cannon_x+2, cannon_y, 7)
		for x = 1, 10 do 
		for y = 1, 10 do 
		local px = offset_x+(x-1)*tilesize
		local py = offset_y+(y-1)*tilesize
		rect(px, py, px + tilesize-1, py +tilesize-1, border_col)
  spr(2,mx,my) --cursor
		end
		end
end



