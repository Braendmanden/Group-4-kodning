pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	grid = {}
	for x = 0, 15 do
	grid[x] = {}
	for y = 0, 15 do

	grid[x][y] = 0

	end
	end
	poke(0x5f2d, 1)
	cannon_x = 64
	cannon_y = 115
	position=100
	timer=3000
	true_timer=0
end

function _update()
	if (timer>0) then
	timer=timer-1
	true_timer=flr(timer/30)
 local mouse_x = stat(32) 
 cannon_x = mid(10, mouse_x, 117)
	end
end

function _draw()
	cls()
	spr(1,4,64) //alien guy
	spr(1,4,54) //one more
	spr(1,4,44) //one more
	spr(1,4,34) //one more
	spr(1,116,64) //one more
	spr(1,116,54) //one more
	spr(1,116,44) //one more
	spr(1,116,34) //one more
	print("timer: "..true_timer,1,1,10)
	print("space spree:",40,10,12) //title card

//cannon body 
	rectfill(cannon_x-8, cannon_y, cannon_x+8, cannon_y+8, 12)

//cannon barrel 
	rectfill(cannon_x-2, cannon_y-6, cannon_x+2, cannon_y, 7)
		for x = 0, 9 do 
		for y = 0, 9 do 
		local px = x * 10
		local py = y * 10
		rect(px, py, px + 9, py + 9, 5)
		end
		end
end



